@{
    ViewData["Title"] = "Inicio - Gimnasio & Clases Grupales";
}

<!-- Hero Section Principal con Gradiente Dinámico y Efectos de Iluminación -->
<div class="bg-dark text-white rounded-4 p-5 mb-5 shadow-lg align-items-center position-relative overflow-hidden" 
     style="background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #312e81 100%);">
    
    <!-- Elemento decorativo de fondo -->
    <div class="position-absolute top-0 end-0 p-5 opacity-10 pointer-events-none display-1 text-light">
        <i class="bi bi-activity" style="font-size: 15rem;"></i>
    </div>

    <div class="row align-items-center position-relative z-1">
        <div class="col-lg-8">
            <span class="badge bg-warning text-dark mb-3 px-3 py-2 fw-bold text-uppercase tracking-wider shadow-sm">
                <i class="bi bi-lightning-charge-fill me-1"></i> Sistema Integral de Gimnasios
            </span>
            <h1 class="display-3 fw-black text-white mb-3 tracking-tight">
                Entrena sin límites, <span class="text-warning">reserva en tiempo real</span>
            </h1>
            <p class="lead text-light opacity-90 mb-4 fs-5 pe-lg-5">
                Accede a las mejores disciplinas grupales con gestión de aforos estrictos, pases digitales con código QR y membresías recurrentes automáticas.
            </p>

            <div class="d-grid gap-3 d-sm-flex justify-content-sm-start">
                <!-- Botón Iniciar Sesión -->
                <a asp-controller="Account" asp-action="Login" class="btn btn-warning btn-lg px-4 fw-bold shadow-sm rounded-3 hover-scale">
                    <i class="bi bi-box-arrow-in-right me-2"></i> Iniciar Sesión
                </a>
                
                <!-- Botón Registro -->
                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-info btn-lg px-4 fw-bold rounded-3 hover-scale">
                    <i class="bi bi-person-plus me-2"></i> Registrarse como Cliente
                </a>
                
                <!-- Ver Planes -->
                <a href="#planes" class="btn btn-outline-light btn-lg px-4 rounded-3">
                    <i class="bi bi-card-checklist me-2"></i> Ver Membresías
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Tarjetas de Características Principales -->
<div class="row g-4 mb-5 text-center">
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm p-4 rounded-4 hover-lift">
            <div class="text-primary mb-3 bg-primary bg-opacity-10 d-inline-flex p-3 rounded-circle mx-auto">
                <i class="bi bi-calendar2-check-fill fs-1"></i>
            </div>
            <h5 class="fw-bold mb-2">Reserva de Cupos en Vivo</h5>
            <p class="text-muted small mb-0">Reserva tu clase al instante. Si el límite máximo $N$ se completa, el sistema te asignará automáticamente en la lista de espera (FIFO).</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm p-4 rounded-4 hover-lift">
            <div class="text-success mb-3 bg-success bg-opacity-10 d-inline-flex p-3 rounded-circle mx-auto">
                <i class="bi bi-qr-code-scan fs-1"></i>
            </div>
            <h5 class="fw-bold mb-2">Pase Digital con QR</h5>
            <p class="text-muted small mb-0">Obtén un pase dinámico con código QR único para confirmar tu reserva e ingresar de manera rápida en la recepción.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm p-4 rounded-4 hover-lift">
            <div class="text-warning mb-3 bg-warning bg-opacity-10 d-inline-flex p-3 rounded-circle mx-auto">
                <i class="bi bi-credit-card-2-front-fill fs-1"></i>
            </div>
            <h5 class="fw-bold mb-2">Pases Sueltos y Membresías</h5>
            <p class="text-muted small mb-0">Suscríbete a planes mensuales recurrentes o adquiere pases individuales para clases específicas sin contratos de permanencia.</p>
        </div>
    </div>
</div>

<!-- Sección de Planes de Membresía -->
<div id="planes" class="mb-5 pt-3">
    <div class="text-center mb-5">
        <span class="text-primary fw-bold text-uppercase small tracking-widest">Nuestras Tarifas</span>
        <h2 class="display-5 fw-bold mt-1">Planes de Membresía & Pases</h2>
        <p class="text-muted">Selecciona la modalidad que mejor se adapte a tu ritmo y objetivos de entrenamiento</p>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-4 align-items-stretch">
        <!-- Pase Suelto -->
        <div class="col">
            <div class="card h-100 border-0 shadow-sm text-center rounded-4 p-2 hover-lift">
                <div class="card-body p-4 d-flex flex-column">
                    <h5 class="fw-bold text-muted">PASE SUELTO</h5>
                    <h2 class="display-5 fw-bold my-3 text-dark">10 Bs <small class="fs-6 text-muted">/ clase</small></h2>
                    <p class="text-muted small mb-4">Ideal para asistentes ocasionales sin compromiso mensual.</p>
                    <ul class="list-unstyled text-start small mb-4 flex-grow-1">
                        <li class="mb-2"><i class="bi bi-check-lg text-success me-2 fw-bold"></i> Acceso a 1 clase grupal específica</li>
                        <li class="mb-2"><i class="bi bi-check-lg text-success me-2 fw-bold"></i> Confirmación de cupo inmediata</li>
                        <li class="mb-2"><i class="bi bi-check-lg text-success me-2 fw-bold"></i> Generación automática de Pase QR</li>
                    </ul>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary fw-bold w-100 py-2 rounded-3">Comprar Pase</a>
                </div>
            </div>
        </div>

        <!-- Plan Mensual Pro (Destacado) -->
        <div class="col">
            <div class="card h-100 border-2 border-primary shadow text-center rounded-4 p-2 position-relative hover-lift bg-white">
                <span class="position-absolute top-0 start-50 translate-middle badge rounded-pill bg-primary px-3 py-2 fw-bold shadow-sm">
                    MÁS POPULAR
                </span>
                <div class="card-body p-4 d-flex flex-column">
                    <h5 class="fw-bold text-primary">PLAN MENSUAL PRO</h5>
                    <h2 class="display-5 fw-bold my-3 text-primary">35 Bs <small class="fs-6 text-muted">/ mes</small></h2>
                    <p class="text-muted small mb-4">Acceso total para quienes entrenan constantemente de forma semanal.</p>
                    <ul class="list-unstyled text-start small mb-4 flex-grow-1">
                        <li class="mb-2"><i class="bi bi-check-lg text-success me-2 fw-bold"></i> Clases grupales ilimitadas</li>
                        <li class="mb-2"><i class="bi bi-check-lg text-success me-2 fw-bold"></i> Reservas prioritarias por cliente</li>
                        <li class="mb-2"><i class="bi bi-check-lg text-success me-2 fw-bold"></i> Cobro mensual recurrente automático</li>
                        <li class="mb-2"><i class="bi bi-check-lg text-success me-2 fw-bold"></i> Cancelación sin penalización hasta 2h antes</li>
                    </ul>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-primary fw-bold w-100 py-2 rounded-3 shadow-sm">Suscribirme Ahora</a>
                </div>
            </div>
        </div>

        <!-- Plan VIP Anual -->
        <div class="col">
            <div class="card h-100 border-0 shadow-sm text-center rounded-4 p-2 hover-lift">
                <div class="card-body p-4 d-flex flex-column">
                    <h5 class="fw-bold text-muted">PLAN VIP ANUAL</h5>
                    <h2 class="display-5 fw-bold my-3 text-dark">320 Bs <small class="fs-6 text-muted">/ año</small></h2>
                    <p class="text-muted small mb-4">Para atletas enfocados que buscan el mejor costo por año.</p>
                    <ul class="list-unstyled text-start small mb-4 flex-grow-1">
                        <li class="mb-2"><i class="bi bi-check-lg text-success me-2 fw-bold"></i> Todos los beneficios del Plan Pro</li>
                        <li class="mb-2"><i class="bi bi-check-lg text-success me-2 fw-bold"></i> Acceso a eventos y talleres exclusivos</li>
                        <li class="mb-2"><i class="bi bi-check-lg text-success me-2 fw-bold"></i> Descuento especial por pago anual</li>
                    </ul>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-dark fw-bold w-100 py-2 rounded-3">Elegir VIP</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Preguntas Frecuentes (Accordion) -->
<div class="mb-5">
    <div class="text-center mb-4">
        <h3 class="fw-bold"><i class="bi bi-question-circle text-primary me-2"></i> Preguntas Frecuentes</h3>
        <p class="text-muted small">Resuelve tus dudas sobre las reservas y pases de acceso</p>
    </div>
    <div class="accordion accordion-flush shadow-sm rounded-4 overflow-hidden border" id="faqAccordion">
        <div class="accordion-item">
            <h2 class="accordion-header" id="faq1">
                <button class="accordion-button fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#collapse1">
                    ¿Cómo funciona la reserva y lista de espera?
                </button>
            </h2>
            <div id="collapse1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                <div class="accordion-body text-muted small">
                    Cada clase tiene un cupo máximo $N$. Si el cupo está disponible, tu reserva queda <strong>CONFIRMADA</strong> inmediatamente. Si el cupo se llena, ingresarás a la <strong>Lista de Espera (FIFO)</strong>. Si alguien cancela con al menos 2 horas de anticipación, serás promovido automáticamente al estado confirmado.
                </div>
            </div>
        </div>
        <div class="accordion-item">
            <h2 class="accordion-header" id="faq2">
                <button class="accordion-button collapsed fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#collapse2">
                    ¿Cómo presento mi pase en recepción?
                </button>
            </h2>
            <div id="collapse2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                <div class="accordion-body text-muted small">
                    Al confirmar tu reserva, se genera un código QR dinámico en tu panel de cliente. Solo debes mostrar la pantalla de tu móvil o el comprobante en la recepción para realizar el check-in instantáneo.
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Estilos CSS Personalizados para Elevación e Interacción -->
<style>
    .hover-lift {
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }
    .hover-lift:hover {
        transform: translateY(-6px);
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.12) !important;
    }
    .hover-scale {
        transition: transform 0.2s ease;
    }
    .hover-scale:hover {
        transform: scale(1.03);
    }
    .tracking-wider {
        letter-spacing: 0.05em;
    }
</style>