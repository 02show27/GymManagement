@model GymManagement.Presentation.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GymManagement</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 512 512'><rect width='512' 
    height='512' rx='110' fill='%231e1e2f'/><path d='M256 70 L370 120 V250 C370 335 320 405 256 440 C192 405 142 335 142 250 V120 L256 70 Z' fill='none' 
    stroke='%2300f2c3' stroke-width='20'/><path d='M130 256 H190 L215 200 L245 310 L275 180 L305 280 L325 256 H382' fill='none' stroke='%23e14eca' stroke-width='20' 
    stroke-linecap='round' stroke-linejoin='round'/></svg>">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
        body {
            background: linear-gradient(135deg, #1e1e2f 0%, #0f0c20 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .card-login {
            background: #27293d;
            border: none;
            border-radius: 1rem;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            color: #ffffff;
            width: 100%;
            max-width: 420px;
            position: relative;
        }
        .form-control {
            background-color: #1e1e2e;
            border: 1px solid #2b2b40;
            color: #ffffff;
        }
        .form-control:focus {
            background-color: #1e1e2e;
            border-color: #e14eca;
            color: #ffffff;
            box-shadow: 0 0 0 0.25rem rgba(225, 78, 202, 0.25);
        }
        .btn-primary-custom {
            background: linear-gradient(to right, #e14eca, #ba54ec);
            border: none;
            border-radius: 0.5rem;
            font-weight: 600;
            padding: 0.75rem;
        }
        .btn-primary-custom:hover {
            opacity: 0.9;
        }
        .brand-logo {
            font-size: 2.5rem;
            color: #e14eca;
        }
        .btn-exit {
            color: #a1a1b5;
            text-decoration: none;
            font-size: 0.875rem;
            transition: color 0.2s ease;
        }
        .btn-exit:hover {
            color: #ffffff;
        }
    </style>
</head>
<body>
    <div class="card card-login p-4">
        <!-- Botón Salir / Volver al Inicio -->
        <div class="d-flex justify-content-between align-items-center mb-2">
            <a asp-controller="Home" asp-action="Index" class="btn-exit fw-semibold">
                <i class="bi bi-arrow-left me-1"></i> Salir al Inicio
            </a>
        </div>

        <div class="text-center mb-4">
            <i class="bi bi-activity brand-logo"></i>
            <h3 class="fw-bold mt-2">GymManagement</h3>
            <p class="text-muted small">Ingresa tus credenciales para acceder</p>
        </div>

        <form asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label small text-uppercase fw-semibold"></label>
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-light"><i class="bi bi-envelope"></i></span>
                    <input asp-for="Email" class="form-control" placeholder="nombre@ejemplo.com" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label small text-uppercase fw-semibold"></label>
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-light"><i class="bi bi-lock"></i></span>
                    <input asp-for="Password" class="form-control" placeholder="••••••••" />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label small text-muted"></label>
            </div>

            <button type="submit" class="btn btn-primary-custom w-100 text-white mb-3">
                <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
            </button>
        </form>

        <div class="text-center border-top border-secondary pt-3 mt-2">
            <p class="small text-muted mb-0">¿No tienes una cuenta aún?</p>
            <a asp-action="Register" class="small text-info text-decoration-none fw-semibold">Regístrate como Cliente aquí</a>
        </div>
    </div>
</body>
</html>