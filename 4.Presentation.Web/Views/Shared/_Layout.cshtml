<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GymManagement</title>
    
    <!-- Bootstrap 5 CSS y Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <!-- Favicon SVG Personalizado de GymManagement -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 512 512'><rect width='512' height='512' rx='110' fill='%231e1e2f'/><path d='M256 70 L370 120 V250 C370 335 320 405 256 440 C192 405 142 335 142 250 V120 L256 70 Z' fill='none' stroke='%2300f2c3' stroke-width='20'/><path d='M130 256 H190 L215 200 L245 310 L275 180 L305 280 L325 256 H382' fill='none' stroke='%23e14eca' stroke-width='20' stroke-linecap='round' stroke-linejoin='round'/></svg>">

    <style>
        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .footer {
            margin-top: auto;
        }
    </style>
</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom box-shadow mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-lightning-charge-fill text-warning"></i> GymManagement
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i> Inicio</a>
                        </li>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Administrador"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-warning fw-semibold" asp-controller="AdminDashboard" asp-action="Index">
                                        <i class="bi bi-gear-fill"></i> Panel de Administración
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-info fw-semibold" asp-controller="ClienteDashboard" asp-action="Index">
                                        <i class="bi bi-speedometer2"></i> Mi Panel de Socio
                                    </a>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white-50" asp-controller="Home" asp-action="Index" asp-fragment="planes"><i class="bi bi-card-checklist"></i> Planes & Membresías</a>
                            </li>
                        }
                    </ul>

                    <!-- Sección de Cuenta / Autenticación -->
                    <ul class="navbar-nav">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white fw-bold" href="#" id="navbarUserDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle text-warning me-1"></i> @User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="navbarUserDropdown">
                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="AdminDashboard" asp-action="Index"><i class="bi bi-gear me-2"></i> Dashboard Admin</a></li>
                                    }
                                    else
                                    {
                                        <li><a class="dropdown-item" asp-controller="ClienteDashboard" asp-action="Index"><i class="bi bi-person me-2"></i> Mi Perfil de Socio</a></li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="px-2">
                                            <button type="submit" class="btn btn-danger btn-sm w-100 text-start">
                                                <i class="bi bi-box-arrow-right me-2"></i> Cerrar Sesión
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2">
                                <a class="btn btn-outline-light btn-sm px-3 mt-1" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-warning btn-sm px-3 mt-1 fw-bold" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus me-1"></i> Registrarse
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-white py-3 mt-auto shadow-sm">
        <div class="container text-center small">
            &copy; 2026 - <strong>GymManagement</strong> Todos los derechos reservados - <a href="http://jtitocastroapp.com:5215" class="text-decoration-none text-muted">jtitocastroapp.com</a> - Sistema de Gestión con Clases Grupales
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>